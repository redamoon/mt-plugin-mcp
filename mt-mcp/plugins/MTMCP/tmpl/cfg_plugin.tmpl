<fieldset>
    <div class="field field-left-label pkg">
        <div class="field-header">
            <label for="api_token"><__trans phrase="API Token"></label>
        </div>
        <div class="field-content">
            <input type="text" name="api_token" id="api_token"
                   value="<mt:var name="api_token" escape="html">"
                   class="full-width" size="60" />
            <p class="hint"><__trans phrase="MCP クライアントが Bearer トークンとして使用するトークン文字列を設定してください。"></p>
        </div>
    </div>
</fieldset>
