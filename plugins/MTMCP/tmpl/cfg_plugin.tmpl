<mtapp:setting
   id="mtmcp-token"
   label="MCP トークン">

  <p class="hint">
    ブラウザ経由でログインする OAuth 方式（推奨）を使う場合はこのボタンは不要です。
    詳しくは README を参照してください。ここで発行するトークンは非対話的な検証や
    フォールバック用途向けです。
  </p>

  <button type="button" id="mtmcp-gen-btn" class="btn btn-primary">
    トークンを発行する
  </button>

  <div id="mtmcp-result" style="display:none;" class="mt-3">
    <div class="input-group" style="max-width:640px;">
      <input type="text" id="mtmcp-token-value" readonly class="form-control"
             style="font-family:monospace;font-size:12px;" />
      <button type="button" id="mtmcp-copy-btn" class="btn btn-default"
              onclick="mtmcpCopy()">コピー</button>
    </div>

    <p class="hint mt-2">
      Cursor（<code>~/.cursor/mcp.json</code>）・Claude Desktop（<code>claude_desktop_config.json</code>）
      向けの設定です。設定ファイルがまだ無い・MCPサーバーを他に登録していない場合は、
      このJSON全体をそのままファイルに貼り付けてください。既に他のMCPサーバーを
      設定済みの場合は、全体を貼り付けずに <code>movable-type</code> の項目だけを
      既存の <code>mcpServers</code> オブジェクトの中にコピーしてください
      （そのまま貼ると <code>mcpServers</code> が二重にネストされてしまいます）。
    </p>
    <div style="position:relative;max-width:640px;">
      <pre id="mtmcp-config-example" class="bg-white p-2" style="font-size:11px;overflow-x:auto;"></pre>
      <button type="button" id="mtmcp-config-copy-btn" class="btn btn-default"
              onclick="mtmcpConfigCopy()">JSONをコピー</button>
    </div>
  </div>

  <div id="mtmcp-error" class="text-danger mt-2" style="display:none;"></div>

  <p class="hint mt-2">
    有効期限は発行から 7 日間です。再発行しても以前のトークンは即時無効になりません。
  </p>
</mtapp:setting>

<script>
(function () {
    var scriptUrl = '<mt:var name="script_url" escape="js">';

    document.getElementById('mtmcp-gen-btn').addEventListener('click', function () {
        var btn = this;
        btn.disabled = true;
        btn.textContent = '発行中...';
        document.getElementById('mtmcp-error').style.display = 'none';

        fetch(scriptUrl, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'X-Requested-With': 'XMLHttpRequest'
            },
            body: '__mode=gen_mcp_token'
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (data.token) {
                document.getElementById('mtmcp-token-value').value = data.token;

                var config = {
                    mcpServers: {
                        'movable-type': {
                            type: 'sse',
                            url: data.mcp_url,
                            headers: {
                                Authorization: 'Bearer ' + data.token
                            }
                        }
                    }
                };
                document.getElementById('mtmcp-config-example').textContent =
                    JSON.stringify(config, null, 2);
                document.getElementById('mtmcp-result').style.display = 'block';
            } else {
                document.getElementById('mtmcp-error').textContent = data.error || 'エラーが発生しました';
                document.getElementById('mtmcp-error').style.display = 'block';
            }
        })
        .catch(function () {
            document.getElementById('mtmcp-error').textContent = 'リクエストに失敗しました';
            document.getElementById('mtmcp-error').style.display = 'block';
        })
        .finally(function () {
            btn.disabled = false;
            btn.textContent = 'トークンを発行する';
        });
    });

    window.mtmcpCopy = function () {
        var input = document.getElementById('mtmcp-token-value');
        input.select();
        input.setSelectionRange(0, 99999);
        document.execCommand('copy');
        var btn = document.getElementById('mtmcp-copy-btn');
        btn.textContent = 'コピーしました';
        setTimeout(function () { btn.textContent = 'コピー'; }, 2000);
    };

    window.mtmcpConfigCopy = function () {
        var text = document.getElementById('mtmcp-config-example').textContent;

        var fallbackCopy = function () {
            var range = document.createRange();
            range.selectNode(document.getElementById('mtmcp-config-example'));
            window.getSelection().removeAllRanges();
            window.getSelection().addRange(range);
            var copied = document.execCommand('copy');
            window.getSelection().removeAllRanges();
            return copied;
        };

        var showCopied = function () {
            var btn = document.getElementById('mtmcp-config-copy-btn');
            btn.textContent = 'コピーしました';
            setTimeout(function () { btn.textContent = 'JSONをコピー'; }, 2000);
        };

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(showCopied, function () {
                if (fallbackCopy()) { showCopied(); }
            });
        } else if (fallbackCopy()) {
            showCopied();
        }
    };
}());
</script>
